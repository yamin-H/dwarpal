{
  "uid": "dwarpal-gateway",
  "title": "Dwarpal Gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Cache hit ratio (5m)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
     "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(rate(dwarpal_requests_total{cache=~\"HIT.*\"}[5m])) / clamp_min(sum(rate(dwarpal_requests_total[5m])), 0.001)"}]},
    {"id": 2, "type": "stat", "title": "Error rate (5m)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
     "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(rate(dwarpal_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(dwarpal_requests_total[5m])), 0.001)"}]},
    {"id": 3, "type": "stat", "title": "Requests per second",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(rate(dwarpal_requests_total[1m]))"}]},
    {"id": 4, "type": "stat", "title": "Open circuits",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
     "fieldConfig": {"defaults": {}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(dwarpal_provider_circuit_open) or vector(0)"}]},
    {"id": 5, "type": "timeseries", "title": "Requests per second by cache result",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (cache) (rate(dwarpal_requests_total[1m]))", "legendFormat": "{{cache}}"}]},
    {"id": 6, "type": "timeseries", "title": "Latency p95 by cache result",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, cache) (rate(dwarpal_request_duration_seconds_bucket[5m])))", "legendFormat": "{{cache}}"}]},
    {"id": 7, "type": "timeseries", "title": "Time to first token p95",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, source) (rate(dwarpal_ttft_seconds_bucket[5m])))", "legendFormat": "{{source}}"}]},
    {"id": 8, "type": "timeseries", "title": "Tokens per minute by tenant",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "fieldConfig": {"defaults": {}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (tenant, type) (rate(dwarpal_tokens_total[5m])) * 60", "legendFormat": "{{tenant}} {{type}}"}]},
    {"id": 9, "type": "timeseries", "title": "Provider calls per second",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (provider, outcome) (rate(dwarpal_provider_calls_total[1m]))", "legendFormat": "{{provider}} {{outcome}}"}]},
    {"id": 10, "type": "timeseries", "title": "HTTP responses per second by class",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (status_class) (rate(dwarpal_http_responses_total[1m]))", "legendFormat": "{{status_class}}"}]},
    {"id": 11, "type": "timeseries", "title": "Spend per hour by tenant (USD)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
     "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (tenant) (increase(dwarpal_cost_usd_total[1h]))", "legendFormat": "{{tenant}}"}]},
    {"id": 12, "type": "timeseries", "title": "Budget rejections per second",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (tenant, kind) (rate(dwarpal_budget_rejections_total[1m]))", "legendFormat": "{{tenant}} {{kind}}"}]}
  ]
}