DWARPAL_APP_ENV=dev
DWARPAL_MOCK_DELAY_MS=0
DWARPAL_ADMIN_KEY=change-me
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REDIS_PASSWORD=dwarpal_dev
# Local run without Docker Redis? Leave DWARPAL_REDIS_URL unset and the cache stays disabled.
QDRANT_API_KEY=dwarpal_dev
INSTALL_ML=false
DWARPAL_SEMANTIC_CACHE_ENABLED=false
DWARPAL_EMBEDDER=sentence-transformers
DWARPAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DWARPAL_EMBEDDING_PREFIX=query:
DWARPAL_SEMANTIC_THRESHOLD=0.95
DWARPAL_ROUTING_CONFIG=
DWARPAL_LOG_LEVEL=INFO
DWARPAL_LOG_JSON=true
GRAFANA_PASSWORD=change-me
DWARPAL_PRICES_CONFIG=

# Demo UI at /playground. Turn on for demos only.
DWARPAL_PLAYGROUND_ENABLED=false

# Admin UI at http://localhost:8001/console. For local use only. Never enable on a public deployment.
DWARPAL_CONSOLE_ENABLED=false